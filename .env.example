# Copy to `.env.local` and adjust. Vite reads env files ONLY at startup —
# restart `npm run dev` / `npm run dev:electron` after changing anything here.

# Base URL for the reprocess endpoints (POST /review/documents/:id/reprocess and
# the /reprocess-runs polling calls).
#
# These endpoints are served by the Python/Flask service (AarogyaAI `server.py`),
# NOT by the Go API — so they do not necessarily live at the same host you type
# into the login screen's API URL field. That field sets the base URL for every
# OTHER call (login, documents, users); this variable is separate and is baked in
# at build time.
#
# IMPORTANT: if this is unset, the app silently falls back to
# `http://localhost:8000`, and every reprocess attempt fails against a port
# nothing is listening on. Set it explicitly.
#
# Against the deployed backend (production/beta are the same host):
VITE_REPROCESS_API_URL=https://api.aarogyasarthi.com
#
# Against a locally-running AarogyaAI (`python3 server.py`), use instead:
# VITE_REPROCESS_API_URL=http://localhost:8000
